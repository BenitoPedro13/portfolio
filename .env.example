# Canonical site URL. OPTIONAL.
#
# On Vercel you can leave this unset: the app reads VERCEL_PROJECT_PRODUCTION_URL
# on production deploys and VERCEL_URL on previews, both injected automatically.
#
# Set it only to pin a specific custom domain, or when hosting somewhere other
# than Vercel. The protocol is optional (https:// is assumed).
#
# NEXT_PUBLIC_SITE_URL=https://benitopedro.dev

# Umami analytics (self-hosted). Both required to enable tracking; the script
# is only loaded in production builds (see src/app/layout.tsx).
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
